---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Engineering Wiki — Aleph Innovation";
const description =
  "Public engineering documentation for Aleph Innovation projects, beginning with Agentic Portfolio.";
---

<BaseLayout title={title} description={description}>
  <section class="wiki-home section">
    <div class="container-wide wiki-home-container">
      <header class="wiki-home-header">
        <p class="wiki-home-eyebrow">ENGINEERING WIKI</p>

        <h1>
          Public documentation
          <span>for systems under construction.</span>
        </h1>

        <p>
          The Aleph Innovation Engineering Wiki documents architecture,
          contracts, implementation, testing, failures and lessons learned.
          It is designed as an inspectable technical record rather than a
          marketing summary.
        </p>
      </header>

      <div class="wiki-projects">
        <article class="wiki-project-card">
          <div class="wiki-project-topline">
            <span class="wiki-project-status">ACTIVE R&amp;D</span>
            <span>01</span>
          </div>

          <p class="wiki-project-domain">
            AGENTIC AI · PORTFOLIO SYSTEMS
          </p>

          <h2>Agentic Portfolio</h2>

          <p>
            Aleph Innovation's first active R&amp;D project explores the
            integration of deterministic portfolio analysis, quantitative
            risk controls, research, probabilistic AI and agentic
            decision-support.
          </p>

          <div class="wiki-project-map">
            <span>System Overview</span>
            <span>Architecture</span>
            <span>Contracts</span>
            <span>Implementation</span>
            <span>Testing</span>
            <span>History</span>
          </div>

          <a href="/wiki/agentic-portfolio/">
            Enter Agentic Portfolio Wiki
            <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>

      <div class="wiki-home-principle">
        <span class="principle-dot" aria-hidden="true"></span>

        <p>
          The executable repository remains authoritative for code. The Wiki
          provides the public engineering narrative, architecture and
          validation context around that implementation.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wiki-home {
    min-height: calc(100vh - 4.8rem);
  }

  .wiki-home-container {
    max-width: 82rem;
  }

  .wiki-home-header {
    max-width: 70rem;

    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .wiki-home-eyebrow {
    margin: 0 0 1.35rem;

    color: var(--aleph-green);

    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;

    letter-spacing: 0.22em;
  }

  h1 {
    max-width: 16ch;
    margin: 0;

    font-size: clamp(3rem, 5vw, 5.4rem);
    line-height: 1.01;
    letter-spacing: -0.05em;
  }

  h1 span {
    display: block;

    margin-top: 0.08em;

    background:
      linear-gradient(
        92deg,
        var(--aleph-green),
        var(--aleph-cyan) 48%,
        var(--aleph-blue-bright)
      );

    background-clip: text;
    -webkit-background-clip: text;

    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .wiki-home-header > p:last-child {
    max-width: 58rem;

    margin: 1.8rem 0 0;

    color: var(--aleph-text-secondary);

    font-size: clamp(1rem, 1.2vw, 1.14rem);
    line-height: 1.75;
  }

  .wiki-project-card {
    position: relative;

    max-width: 70rem;

    padding: clamp(2rem, 4vw, 3rem);

    border: 1px solid rgba(90, 180, 220, 0.24);
    border-radius: 1rem;

    background:
      linear-gradient(
        145deg,
        rgba(10, 37, 61, 0.75),
        rgba(3, 18, 34, 0.86)
      );

    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.025),
      0 18px 48px rgba(0, 0, 0, 0.13);
  }

  .wiki-project-card::before {
    content: "";

    position: absolute;

    top: -1px;
    left: 2rem;
    right: 2rem;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--aleph-green),
        var(--aleph-cyan),
        var(--aleph-blue),
        transparent
      );
  }

  .wiki-project-topline {
    display: flex;
    justify-content: space-between;

    margin-bottom: 2rem;

    color: var(--aleph-text-muted);

    font-family: var(--font-mono);
    font-size: 0.58rem;

    letter-spacing: 0.14em;
  }

  .wiki-project-status {
    color: var(--aleph-green);
  }

  .wiki-project-domain {
    margin: 0 0 0.8rem;

    color: var(--aleph-cyan);

    font-family: var(--font-mono);
    font-size: 0.58rem;

    letter-spacing: 0.15em;
  }

  .wiki-project-card h2 {
    margin: 0;

    font-size: clamp(2rem, 3vw, 3rem);
  }

  .wiki-project-card > p:not(.wiki-project-domain) {
    max-width: 52rem;

    margin: 1.2rem 0 0;

    color: var(--aleph-text-secondary);

    line-height: 1.7;
  }

  .wiki-project-map {
    display: flex;
    flex-wrap: wrap;

    gap: 0.5rem;

    margin-top: 1.6rem;
  }

  .wiki-project-map span {
    padding: 0.42rem 0.65rem;

    border: 1px solid rgba(90, 180, 220, 0.18);
    border-radius: var(--radius-pill);

    color: var(--aleph-text-muted);

    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  .wiki-project-card > a {
    display: inline-flex;
    align-items: center;

    gap: 0.6rem;

    min-height: 2.8rem;

    margin-top: 2rem;
    padding-inline: 1rem;

    border: 1px solid rgba(22, 201, 216, 0.42);
    border-radius: var(--radius-pill);

    background: rgba(22, 201, 216, 0.05);

    color: var(--aleph-text-primary);

    font-size: 0.78rem;
    font-weight: 600;
  }

  .wiki-home-principle {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);

    gap: 1rem;
    align-items: center;

    max-width: 70rem;

    margin-top: 2rem;
    padding: 1.2rem 1.4rem;

    border-top: 1px solid rgba(90, 180, 220, 0.1);
    border-bottom: 1px solid rgba(90, 180, 220, 0.1);
  }

  .principle-dot {
    width: 0.42rem;
    height: 0.42rem;

    border-radius: 50%;

    background: var(--aleph-green);

    box-shadow:
      0 0 10px rgba(85, 214, 158, 0.5);
  }

  .wiki-home-principle p {
    margin: 0;

    color: var(--aleph-text-secondary);

    font-size: 0.8rem;
    line-height: 1.6;
  }
</style>
