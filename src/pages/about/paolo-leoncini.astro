---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import { trainer } from "../../data/trainer";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: trainer.name,
  jobTitle: "Applied AI engineer and trainer",
  image: `https://alephinnovation.com${trainer.photo}`,
  url: `https://alephinnovation.com/about/${trainer.slug}/`,
  worksFor: { "@type": "Organization", name: "Aleph Innovation", url: "https://alephinnovation.com/" },
  sameAs: trainer.links.map((l) => l.href),
};
---

<BaseLayout
  title={`${trainer.name}, AI trainer — Aleph Innovation`}
  description={trainer.short}
  socialImage={trainer.photo}
>
  <section class="training-hero section" aria-labelledby="profile-title">
    <div class="container-wide">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/services/">Services</a>
        <span aria-hidden="true">/</span>
        <a href="/services/training/">AI training</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Trainer</span>
      </nav>
      <div class="profile-head">
        <img class="profile-photo" src={trainer.photo} alt={trainer.name} width="640" height="640" />
        <div>
          <p class="eyebrow">Trainer profile</p>
          <h1 id="profile-title">{trainer.name}</h1>
          <p class="profile-role">{trainer.role}</p>
        </div>
      </div>
      <p class="lead">{trainer.intro}</p>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="builds-title">
    <div class="container-wide">
      <h2 id="builds-title" class="training-h2">What I build</h2>
      <ul class="training-notes">
        {trainer.builds.map((b) => <li><strong>{b.title}</strong> {b.text}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="teach-title">
    <div class="container-wide">
      <h2 id="teach-title" class="training-h2">How I teach</h2>
      <p class="training-intro">{trainer.teaching}</p>
      <a class="services-button services-button-primary" href="/services/training/">See the AI training offers</a>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="career-title">
    <div class="container-wide">
      <h2 id="career-title" class="training-h2">Career highlights</h2>
      <div class="table-scroll">
        <table class="training-table">
          <thead>
            <tr><th scope="col">Period</th><th scope="col">Role</th><th scope="col">Organisation</th></tr>
          </thead>
          <tbody>
            {trainer.career.map((r) => (
              <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="edu-title">
    <div class="container-wide">
      <dl class="terms-list">
        <div>
          <dt id="edu-title">Education and certifications</dt>
          {trainer.education.map((e) => <dd>{e}</dd>)}
        </div>
        <div>
          <dt>Languages</dt>
          <dd>{trainer.languages}</dd>
        </div>
      </dl>
      <div class="other-links profile-links">
        {trainer.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="services-cta section" aria-labelledby="cta-title">
    <div class="container-wide cta-inner">
      <h2 id="cta-title">Let's talk about your training</h2>
      <p>Book a free 30-minute call and I'll suggest the right course for your team or for you.</p>
      <a class="services-button services-button-primary" href="mailto:info@alephinnovation.com?subject=AI%20training">
        info@alephinnovation.com
      </a>
      <p class="cta-location">Gozo, Malta · on site in Malta and Gozo, live online across the EU</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Footer />
</BaseLayout>

<style>
  @import "../../styles/training.css";

  .profile-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .profile-head h1 {
    margin-bottom: var(--space-3);
  }

  .profile-photo {
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--aleph-border-strong);
  }

  .profile-role {
    margin: 0;
    color: var(--aleph-text-secondary);
    font-weight: var(--font-weight-semibold);
  }

  .terms-list dd + dd {
    margin-top: var(--space-2);
  }

  .profile-links {
    margin-top: var(--space-8);
  }

  @media (max-width: 640px) {
    .profile-photo {
      width: 8rem;
      height: 8rem;
    }
  }
</style>
