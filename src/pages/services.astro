---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const services = [
  {
    number: "01",
    id: "applied-ai",
    domain: "APPLIED AI PROJECTS",
    title: "Feasibility studies, prototypes and evaluations",
    lead:
      "You have a process, a set of documents or a collection of images, and a question: can AI handle this reliably, and at what cost? We answer it with evidence, not demos.",
    items: [
      "Feasibility studies with a clear recommendation: proceed, narrow, collect more data or stop",
      "Working prototypes with a browser-based review interface for your staff",
      "Fair comparison of approaches: general-purpose AI models, custom classifiers, retrieval",
      "Document copilots (retrieval-augmented AI) over manuals, procedures and FAQs",
      "Agentic workflows where AI prepares and a named person decides",
    ],
    format: "Fixed-price project, typically 6 to 12 weeks",
    price: "From €15,000",
    audience: "Public bodies, hospitals, SMEs in Malta and across the EU (remote delivery)",
  },
  {
    number: "02",
    id: "environmental-monitoring",
    domain: "ENVIRONMENTAL MONITORING",
    title: "Early, verified signals for coast and groundwater",
    lead:
      "Field sensors, open public data and satellite imagery, checked by AI agents and delivered as a documented evidence pack to the person who decides.",
    items: [
      "Pilot on one site: sensor installation, monitoring and a final evidence report",
      "Validated, corroborated alerts with fewer false alarms",
      "Monthly evidence reports and a map-based view of your site",
      "Risk assessments built on our published Gozo risk register",
    ],
    format: "3 to 6 month pilot, then a monthly service per site",
    price: "Pilot from €3,000 · service from €300 per site per month",
    audience: "Local councils, public agencies, hotels and beach concessions, marinas, aquaculture",
  },
  {
    number: "03",
    id: "training-advisory",
    domain: "AI TRAINING AND ADVISORY",
    title: "Practical AI adoption for your team",
    lead:
      "Hands-on sessions and short assessments that help your team use AI safely and productively, and decide where it is worth investing.",
    items: [
      "Half-day and full-day workshops, delivered on site in Malta and Gozo or online",
      "AI adoption assessment: where AI fits in your processes, with a costed plan",
      "The EU AI Act in practice: what applies to your use cases",
      "Technical scope for digitalisation projects that may qualify for Maltese co-funding schemes",
    ],
    format: "Workshop or 1 to 2 week assessment",
    price: "Workshops from €1,500",
    audience: "SMEs, professional firms, business associations",
  },
];

const steps = [
  {
    title: "Initial call",
    text: "A free 30-minute conversation about your problem, your data and your constraints.",
  },
  {
    title: "Written proposal",
    text: "Scope, deliverables, schedule and a fixed price. No open-ended billing.",
  },
  {
    title: "Delivery with evidence",
    text: "Test data kept separate from the start, results frozen before final testing, every result traceable.",
  },
  {
    title: "Handover",
    text: "Your data, code and reports in open formats, with instructions to run and extend them.",
  },
];

const principles = [
  "A named person always takes the final decision",
  "Honest measurement: accuracy, coverage and errors reported separately",
  "Data hosted in the EU, processed under GDPR",
  "Open formats and full handover, no lock-in",
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Aleph Innovation",
  url: "https://alephinnovation.com/services/",
  email: "info@alephinnovation.com",
  description:
    "Applied AI projects, environmental monitoring and AI training for public bodies and companies in Malta and the EU.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ghajnsielem",
    addressRegion: "Gozo",
    addressCountry: "MT",
  },
  areaServed: ["Malta", "European Union"],
  sameAs: ["https://www.linkedin.com/company/alephinnovation/"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.lead,
        url: `https://alephinnovation.com/services/#${service.id}`,
      },
    })),
  },
};
---

<BaseLayout
  title="Services — Aleph Innovation"
  description="Applied AI projects, environmental monitoring and AI training for public bodies and companies in Malta and the EU. Fixed-price proposals, evidence-based delivery, from Gozo."
>
  <section class="services-hero section" aria-labelledby="services-title">
    <div class="container-wide">
      <p class="eyebrow">Services</p>
      <h1 id="services-title">
        Applied AI,
        <span class="text-gradient">engineered as a system.</span>
      </h1>
      <p class="lead">
        The same engineering that drives our research projects is available
        for your organisation: auditable AI, measured honestly, with people in
        charge of every decision.
      </p>
      <div class="services-hero-actions">
        <a
          class="services-button services-button-primary"
          href="mailto:info@alephinnovation.com?subject=Initial%20call"
        >
          Book a free 30-minute call
        </a>
        <a class="services-button" href="#how-we-work">How we work</a>
      </div>
    </div>
  </section>

  <section class="services-list section-compact" aria-label="Service lines">
    <div class="container-wide services-grid">
      {
        services.map((service) => (
          <article class="service-card" id={service.id}>
            <div class="service-topline">
              <span>{service.domain}</span>
              <span>{service.number}</span>
            </div>

            <h2>{service.title}</h2>
            <p class="service-lead">{service.lead}</p>

            <ul class="service-items">
              {service.items.map((item) => <li>{item}</li>)}
            </ul>

            <dl class="service-facts">
              <div>
                <dt>Format</dt>
                <dd>{service.format}</dd>
              </div>
              <div>
                <dt>Indicative price</dt>
                <dd class="service-price">{service.price}</dd>
              </div>
              <div>
                <dt>For</dt>
                <dd>{service.audience}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
    <p class="container-wide services-note">
      Prices exclude VAT. Every engagement starts with a written, fixed-price
      proposal based on your scope.
    </p>
  </section>

  <section
    id="how-we-work"
    class="services-process section"
    aria-labelledby="process-title"
  >
    <div class="container-wide process-layout">
      <div>
        <p class="eyebrow">How we work</p>
        <h2 id="process-title">From question to evidence.</h2>
        <ul class="principles">
          {principles.map((principle) => <li>{principle}</li>)}
        </ul>
      </div>

      <ol class="process-steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="process-index">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="services-proof section-compact" aria-labelledby="proof-title">
    <div class="container-wide proof-card">
      <div>
        <p class="eyebrow">See the work</p>
        <h2 id="proof-title">Our research is public.</h2>
        <p>
          Explore the Gozo Risk Map and the engineering wiki to see how we
          design, document and test AI systems before we offer them to clients.
        </p>
      </div>
      <div class="proof-links">
        <a href="/gozo-risk-map/">Gozo Risk Map <span aria-hidden="true">↗</span></a>
        <a href="/wiki/environmental-monitoring/">Environmental Monitoring wiki <span aria-hidden="true">↗</span></a>
        <a href="/wiki/agentic-portfolio/">Agentic Portfolio wiki <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="services-cta section" aria-labelledby="cta-title">
    <div class="container-wide cta-inner">
      <h2 id="cta-title">Have a problem AI might solve?</h2>
      <p>
        Tell us about it in a few lines. We reply within two working days.
      </p>
      <a
        class="services-button services-button-primary"
        href="mailto:info@alephinnovation.com?subject=Initial%20call"
      >
        info@alephinnovation.com
      </a>
      <p class="cta-location">Gozo, Malta · working on site in Malta and remotely across the EU</p>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <Footer />
</BaseLayout>

<style>
  .services-hero h1 {
    max-width: 16ch;
    margin: 0 0 var(--space-6);

    font-size: clamp(2.6rem, 5.4vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .services-hero h1 span {
    display: block;
  }

  .services-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);

    margin-top: var(--space-8);
  }

  .services-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 2.9rem;
    padding-inline: var(--space-6);

    border: 1px solid var(--aleph-border-strong);
    border-radius: var(--radius-pill);

    background: rgba(7, 27, 48, 0.74);

    color: var(--aleph-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .services-button:hover {
    border-color: rgba(22, 201, 216, 0.56);
    transform: translateY(-1px);
  }

  .services-button-primary {
    border-color: transparent;
    background: var(--aleph-gradient-primary);
    color: var(--aleph-text-inverse);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .service-card {
    display: flex;
    flex-direction: column;

    padding: clamp(1.4rem, 2.4vw, 2rem);

    border: 1px solid var(--aleph-border);
    border-radius: var(--radius-xl);

    background: var(--aleph-gradient-surface);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);

    scroll-margin-top: 6rem;
  }

  .service-topline {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);

    margin-bottom: var(--space-6);

    color: var(--aleph-green);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
  }

  .service-topline span:last-child {
    color: var(--aleph-text-muted);
  }

  .service-card h2 {
    margin: 0 0 var(--space-4);

    font-size: clamp(1.35rem, 1.9vw, 1.7rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .service-lead {
    margin: 0 0 var(--space-6);

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .service-items {
    display: grid;
    gap: var(--space-3);

    margin: 0 0 var(--space-8);
    padding: 0;

    list-style: none;
  }

  .service-items li {
    position: relative;

    padding-left: 1.25rem;

    color: var(--aleph-text-primary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .service-items li::before {
    content: "";

    position: absolute;
    left: 0;
    top: 0.6em;

    width: 0.45rem;
    height: 1px;

    background: var(--aleph-cyan);
  }

  .service-facts {
    display: grid;
    gap: var(--space-4);

    margin: auto 0 0;
    padding-top: var(--space-6);

    border-top: 1px solid var(--aleph-border-subtle);
  }

  .service-facts dt {
    margin-bottom: 0.2rem;

    color: var(--aleph-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-facts dd {
    margin: 0;

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .service-facts .service-price {
    color: var(--aleph-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .services-note {
    margin-top: var(--space-6);

    color: var(--aleph-text-muted);
    font-size: var(--font-size-xs);
  }

  .services-process {
    border-top: 1px solid rgba(90, 180, 220, 0.08);
  }

  .process-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .process-layout h2 {
    margin: 0 0 var(--space-8);

    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .principles {
    display: grid;
    gap: var(--space-3);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .principles li {
    padding: var(--space-3) var(--space-4);

    border: 1px solid var(--aleph-border-subtle);
    border-radius: var(--radius-md);

    background: rgba(7, 27, 48, 0.5);

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
  }

  .process-steps {
    display: grid;
    gap: var(--space-4);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .process-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);

    padding: var(--space-6);

    border: 1px solid var(--aleph-border);
    border-radius: var(--radius-lg);

    background: var(--aleph-gradient-surface);
  }

  .process-index {
    color: var(--aleph-cyan);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .process-steps h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-lg);
  }

  .process-steps p {
    margin: 0;

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .proof-card {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-8);
    align-items: center;

    padding: clamp(1.6rem, 3vw, 2.6rem);

    border: 1px solid var(--aleph-border);
    border-radius: var(--radius-xl);

    background: rgba(7, 27, 48, 0.55);
  }

  .proof-card h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }

  .proof-card p {
    margin: 0;
    color: var(--aleph-text-secondary);
    line-height: var(--line-height-body);
  }

  .proof-links {
    display: grid;
    gap: var(--space-3);
  }

  .proof-links a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);

    padding: var(--space-3) var(--space-4);

    border: 1px solid var(--aleph-border-subtle);
    border-radius: var(--radius-md);

    color: var(--aleph-text-primary);
    font-size: var(--font-size-sm);
  }

  .proof-links a:hover {
    border-color: rgba(22, 201, 216, 0.4);
    color: var(--aleph-cyan);
  }

  .cta-inner {
    text-align: center;
  }

  .cta-inner h2 {
    margin: 0 0 var(--space-4);

    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.035em;
  }

  .cta-inner p {
    margin: 0 auto var(--space-8);
    max-width: 36rem;

    color: var(--aleph-text-secondary);
  }

  .cta-inner .cta-location {
    margin: var(--space-6) auto 0;

    color: var(--aleph-text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }

  @media (max-width: 1100px) {
    .services-grid {
      grid-template-columns: 1fr;
      max-width: 46rem;
    }
  }

  @media (max-width: 820px) {
    .process-layout,
    .proof-card {
      grid-template-columns: 1fr;
    }
  }
</style>
