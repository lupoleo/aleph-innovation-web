---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
import { publishedOffers, type TrainingOffer } from "../../../data/training";

export function getStaticPaths() {
  return publishedOffers.map((offer) => ({
    params: { offer: offer.slug },
    props: { offer },
  }));
}

const { offer } = Astro.props as { offer: TrainingOffer };
const others = publishedOffers.filter((o) => o.slug !== offer.slug);
const mailto = `mailto:info@alephinnovation.com?subject=${encodeURIComponent(offer.mailSubject)}`;
const columns = [...offer.priceColumns, ...(offer.extraColumns ?? [])];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: offer.eyebrow,
  description: offer.lead,
  url: `https://alephinnovation.com/services/training/${offer.slug}/`,
  provider: {
    "@type": "ProfessionalService",
    name: "Aleph Innovation",
    url: "https://alephinnovation.com/",
  },
  areaServed: ["Malta", "European Union"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: offer.eyebrow,
    itemListElement: offer.packages.map((p) => ({
      "@type": "Offer",
      name: p.name,
      price: p.price.replace(/[^0-9.]/g, ""),
      priceCurrency: "EUR",
    })),
  },
};
---

<BaseLayout
  title={`${offer.eyebrow} — Aleph Innovation`}
  description={offer.lead}
>
  <section class="training-hero section" aria-labelledby="training-title">
    <div class="container-wide">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/services/">Services</a>
        <span aria-hidden="true">/</span>
        <a href="/services/training/">AI training</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{offer.cardTitle}</span>
      </nav>
      <p class="eyebrow">{offer.eyebrow}</p>
      <h1 id="training-title">{offer.title}</h1>
      <p class="lead">{offer.lead}</p>
      <p class="training-why">{offer.why}</p>
      <div class="training-actions">
        <a class="services-button services-button-primary" href={mailto}>Book a free 30-minute call</a>
        <a class="services-button" href="#prices">Packages and prices</a>
        <a class="services-button" href="#curriculum">Curriculum</a>
      </div>
    </div>
  </section>

  <section id="prices" class="section-compact" aria-labelledby="prices-title">
    <div class="container-wide">
      <h2 id="prices-title" class="training-h2">Packages and prices</h2>
      <p class="training-intro">{offer.priceIntro}</p>
      <div class="table-scroll">
        <table class="training-table">
          <thead>
            <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {
              offer.packages.map((p) => (
                <tr>
                  <th scope="row">{p.name}</th>
                  <td>{p.duration}</td>
                  <td>{p.group}</td>
                  <td>{p.audience}</td>
                  <td class="price">{p.price}</td>
                  {p.extra && Object.values(p.extra).map((v) => <td class="price">{v}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <ul class="training-notes">
        {offer.priceNotes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section id="curriculum" class="section-compact" aria-labelledby="curriculum-title">
    <div class="container-wide">
      <h2 id="curriculum-title" class="training-h2">Curriculum</h2>
      <div class="curriculum-grid">
        {
          offer.curriculum.map((block) => (
            <article class="curriculum-card">
              <h3>{block.title}</h3>
              <ol>
                {block.modules.map((m) => <li>{m}</li>)}
              </ol>
              <p class="outcome">
                <span>You leave with</span>
                {block.outcome}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="terms-title">
    <div class="container-wide">
      <h2 id="terms-title" class="training-h2">Delivery and terms</h2>
      {
        offer.termsTable && (
          <>
            <p class="training-intro">{offer.termsTable.caption}</p>
            <div class="table-scroll">
              <table class="training-table">
                <thead>
                  <tr>{offer.termsTable.head.map((h) => <th scope="col">{h}</th>)}</tr>
                </thead>
                <tbody>
                  {offer.termsTable.rows.map((r) => (
                    <tr>
                      <th scope="row">{r[0]}</th>
                      {r.slice(1).map((c) => <td>{c}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }
      <dl class="terms-list">
        {
          offer.terms.map((t) => (
            <div>
              <dt>{t.label}</dt>
              <dd>{t.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="services-note">
        Every engagement starts with a written, fixed-price proposal.
      </p>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="other-title">
    <div class="container-wide other-offers">
      <h2 id="other-title" class="training-h2">Other training offers</h2>
      <div class="other-links">
        {
          others.map((o) => (
            <a href={`/services/training/${o.slug}/`}>
              {o.cardTitle} <span aria-hidden="true">→</span>
            </a>
          ))
        }
        <a href="/services/">All services <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="services-cta section" aria-labelledby="cta-title">
    <div class="container-wide cta-inner">
      <h2 id="cta-title">Ready to start?</h2>
      <p>Tell us what you need in a few lines. We reply within two working days.</p>
      <a class="services-button services-button-primary" href={mailto}>info@alephinnovation.com</a>
      <p class="cta-location">Gozo, Malta · on site in Malta and Gozo, live online across the EU</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Footer />
</BaseLayout>

<style>
  @import "../../../styles/training.css";
</style>
