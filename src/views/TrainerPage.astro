---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { getTrainer } from "../data/trainer";
import { getLang, localizePath } from "../i18n";

const lang = getLang(Astro);
const l = (path: string) => localizePath(path, lang);
const trainer = getTrainer(lang);

const ui = {
  en: {
    metaTitle: `${trainer.name}, AI trainer — Aleph Innovation`,
    services: "Services",
    training: "AI training",
    crumb: "Trainer",
    eyebrow: "Trainer profile",
    builds: "What I build",
    teach: "How I teach",
    offers: "See the AI training offers",
    career: "Career highlights",
    period: "Period",
    role: "Role",
    org: "Organisation",
    edu: "Education and certifications",
    langs: "Languages",
    ctaTitle: "Let's talk about your training",
    ctaText: "Book a free 30-minute call and I'll suggest the right course for your team or for you.",
    mailSubject: "AI training",
    ctaLocation: "Gozo, Malta · on site in Malta and Gozo, live online across the EU",
  },
  it: {
    metaTitle: `${trainer.name}, formazione sull'AI — Aleph Innovation`,
    services: "Servizi",
    training: "Formazione AI",
    crumb: "Docente",
    eyebrow: "Profilo docente",
    builds: "Cosa costruisco",
    teach: "Come insegno",
    offers: "Scopri le offerte di formazione AI",
    career: "Percorso professionale",
    period: "Periodo",
    role: "Ruolo",
    org: "Organizzazione",
    edu: "Formazione e certificazioni",
    langs: "Lingue",
    ctaTitle: "Parliamo della tua formazione",
    ctaText: "Prenota una call gratuita di 30 minuti e ti suggerirò il corso più adatto al tuo team o a te.",
    mailSubject: "Formazione AI",
    ctaLocation: "Gozo, Malta · in sede a Malta e Gozo, live online in tutta l'UE",
  },
}[lang];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: trainer.name,
  jobTitle: "Applied AI engineer and trainer",
  image: `https://alephinnovation.com${trainer.photo}`,
  url: `https://alephinnovation.com${l(`/about/${trainer.slug}/`)}`,
  worksFor: { "@type": "Organization", name: "Aleph Innovation", url: "https://alephinnovation.com/" },
  sameAs: trainer.links.map((l) => l.href),
};
---

<BaseLayout
  title={ui.metaTitle}
  description={trainer.short}
  socialImage={trainer.photo}
>
  <section class="training-hero section" aria-labelledby="profile-title">
    <div class="container-wide">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={l("/services/")}>{ui.services}</a>
        <span aria-hidden="true">/</span>
        <a href={l("/services/training/")}>{ui.training}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{ui.crumb}</span>
      </nav>
      <div class="profile-head">
        <img class="profile-photo" src={trainer.photo} alt={trainer.name} width="640" height="640" />
        <div>
          <p class="eyebrow">{ui.eyebrow}</p>
          <h1 id="profile-title">{trainer.name}</h1>
          <p class="profile-role">{trainer.role}</p>
        </div>
      </div>
      <p class="lead">{trainer.intro}</p>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="builds-title">
    <div class="container-wide">
      <h2 id="builds-title" class="training-h2">{ui.builds}</h2>
      <ul class="training-notes">
        {trainer.builds.map((b) => <li><strong>{b.title}</strong> {b.text}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="teach-title">
    <div class="container-wide">
      <h2 id="teach-title" class="training-h2">{ui.teach}</h2>
      <p class="training-intro">{trainer.teaching}</p>
      <a class="services-button services-button-primary" href={l("/services/training/")}>{ui.offers}</a>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="career-title">
    <div class="container-wide">
      <h2 id="career-title" class="training-h2">{ui.career}</h2>
      <div class="table-scroll">
        <table class="training-table">
          <thead>
            <tr><th scope="col">{ui.period}</th><th scope="col">{ui.role}</th><th scope="col">{ui.org}</th></tr>
          </thead>
          <tbody>
            {trainer.career.map((r) => (
              <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="edu-title">
    <div class="container-wide">
      <dl class="terms-list">
        <div>
          <dt id="edu-title">{ui.edu}</dt>
          {trainer.education.map((e) => <dd>{e}</dd>)}
        </div>
        <div>
          <dt>{ui.langs}</dt>
          <dd>{trainer.languages}</dd>
        </div>
      </dl>
      <div class="other-links profile-links">
        {trainer.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="services-cta section" aria-labelledby="cta-title">
    <div class="container-wide cta-inner">
      <h2 id="cta-title">{ui.ctaTitle}</h2>
      <p>{ui.ctaText}</p>
      <a class="services-button services-button-primary" href={`mailto:info@alephinnovation.com?subject=${encodeURIComponent(ui.mailSubject)}`}>
        info@alephinnovation.com
      </a>
      <p class="cta-location">{ui.ctaLocation}</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Footer />
</BaseLayout>

<style>
  @import "../styles/training.css";

  .profile-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .profile-head h1 {
    margin-bottom: var(--space-3);
  }

  .profile-photo {
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--aleph-border-strong);
  }

  .profile-role {
    margin: 0;
    color: var(--aleph-text-secondary);
    font-weight: var(--font-weight-semibold);
  }

  .terms-list dd + dd {
    margin-top: var(--space-2);
  }

  .profile-links {
    margin-top: var(--space-8);
  }

  @media (max-width: 640px) {
    .profile-photo {
      width: 8rem;
      height: 8rem;
    }
  }
</style>
