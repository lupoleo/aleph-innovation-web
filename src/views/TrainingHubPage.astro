---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import TrainerCard from "../components/TrainerCard.astro";
import { getPublishedOffers } from "../data/training";
import { getLang, localizePath } from "../i18n";

const lang = getLang(Astro);
const l = (path: string) => localizePath(path, lang);
const publishedOffers = getPublishedOffers(lang);

const ui = {
  en: {
    metaTitle: "AI training — Aleph Innovation",
    metaDescription: "Hands-on AI training in Malta, Gozo and online: enterprise programmes for companies, academic programmes for universities and research, and short courses for individuals.",
    shared: [
      "Hands-on from the first hour: every session ends with something working",
      "Private by design: models run on your own machines, data stays in the EU",
      "Compute-heavy steps run in a virtual environment to run models, included in the price",
      "Fixed prices, written proposals, certificates of attendance",
    ],
    services: "Services",
    training: "AI training",
    eyebrow: "AI training and advisory",
    title: "Learn AI by building it, on infrastructure you control.",
    lead: "One hands-on programme, from how language models work to private assistants and customised models, offered in formats for companies, academia and individuals.",
    offers: "Training offers",
    more: "See packages and curriculum →",
    note: "Company and academic prices exclude VAT. Every engagement starts with a written, fixed-price proposal.",
    ctaTitle: "Not sure which format fits?",
    ctaText: "Book a free 30-minute call and we'll suggest the right course for your team or for you.",
    mailSubject: "AI training",
    ctaLocation: "Gozo, Malta · on site in Malta and Gozo, live online across the EU",
  },
  it: {
    metaTitle: "Formazione IA — Aleph Innovation",
    metaDescription: "Formazione pratica sull'IA a Malta, a Gozo e online: programmi enterprise per le aziende, programmi accademici per università e ricerca e corsi brevi per privati.",
    shared: [
      "Pratica fin dalla prima ora: ogni sessione si chiude con qualcosa che funziona",
      "Riservatezza by design: i modelli girano sui vostri computer, i dati restano nell'UE",
      "Le fasi più pesanti si svolgono in un ambiente virtuale per l'esecuzione dei modelli, incluso nel prezzo",
      "Prezzi fissi, proposte scritte, attestati di partecipazione",
    ],
    services: "Servizi",
    training: "Formazione IA",
    eyebrow: "Formazione e consulenza IA",
    title: "Imparare l'IA costruendola, su un'infrastruttura che controllate voi.",
    lead: "Un unico programma pratico, dal funzionamento dei modelli linguistici agli assistenti privati e ai modelli personalizzati, proposto in formati per aziende, mondo accademico e privati.",
    offers: "Offerte di formazione",
    more: "Vedi pacchetti e programma →",
    note: "I prezzi per aziende e mondo accademico sono IVA esclusa. Ogni incarico parte da una proposta scritta a prezzo fisso.",
    ctaTitle: "Non sai quale formato fa per te?",
    ctaText: "Prenota una call gratuita di 30 minuti e ti suggeriremo il corso più adatto al tuo team o a te.",
    mailSubject: "Formazione IA",
    ctaLocation: "Gozo, Malta · in sede a Malta e Gozo, live online in tutta l'UE",
  },
  mt: {
    metaTitle: "Taħriġ fl-AI — Aleph Innovation",
    metaDescription: "Taħriġ prattiku fl-AI f'Malta, f'Għawdex u online: programmi għall-kumpaniji, programmi akkademiċi għall-universitajiet u r-riċerka, u korsijiet qosra għall-individwi. Il-korsijiet jingħataw bl-Ingliż jew bit-Taljan.",
    shared: [
      "Prattiku mill-ewwel siegħa: kull sessjoni tispiċċa b'xi ħaġa li taħdem",
      "Privat mid-disinn: il-mudelli jaħdmu fuq il-magni tagħkom, id-data tibqa' fl-UE",
      "Il-passi li jeħtieġu ħafna qawwa tal-ipproċessar isiru f'ambjent virtwali għat-tħaddim tal-mudelli, inkluż fil-prezz",
      "Prezzijiet fissi, proposti bil-miktub, ċertifikati ta' attendenza",
      "Il-korsijiet jingħataw bl-Ingliż jew bit-Taljan",
    ],
    services: "Servizzi",
    training: "Taħriġ fl-AI",
    eyebrow: "Taħriġ u konsulenza fl-AI",
    title: "Itgħallem l-AI billi tibniha, fuq infrastruttura li tikkontrolla int.",
    lead: "Programm prattiku wieħed, minn kif jaħdmu l-mudelli tal-lingwa sa assistenti privati u mudelli adattati, offrut f'formati għall-kumpaniji, għall-akkademja u għall-individwi.",
    offers: "Offerti tat-taħriġ",
    more: "Ara l-pakketti u l-programm →",
    note: "Il-prezzijiet għall-kumpaniji u għall-akkademja huma mingħajr VAT. Kull inkarigu jibda bi proposta bil-miktub bi prezz fiss.",
    ctaTitle: "M'intix ċert liema format jaqbillek?",
    ctaText: "Ibbukkja telefonata b'xejn ta' 30 minuta u nissuġġerixxu l-kors li jaqbel l-aħjar għat-tim tiegħek jew għalik.",
    mailSubject: "Taħriġ fl-AI",
    ctaLocation: "Għawdex, Malta · fil-post f'Malta u f'Għawdex, live online madwar l-UE",
  },
}[lang];
const shared = ui.shared;
---

<BaseLayout title={ui.metaTitle} description={ui.metaDescription}>
  <section class="training-hero section" aria-labelledby="hub-title">
    <div class="container-wide">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={l("/services/")}>{ui.services}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{ui.training}</span>
      </nav>
      <p class="eyebrow">{ui.eyebrow}</p>
      <h1 id="hub-title">{ui.title}</h1>
      <p class="lead">{ui.lead}</p>
      <ul class="hub-shared">
        {shared.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-compact" aria-label={ui.offers}>
    <div class="container-wide hub-grid">
      {
        publishedOffers.map((o) => (
          <a class="hub-card" href={l(`/services/training/${o.slug}/`)}>
            <span class="hub-eyebrow">{o.eyebrow}</span>
            <h2>{o.cardTitle}</h2>
            <p>{o.cardText}</p>
            <span class="hub-price">{o.cardPrice}</span>
            <span class="hub-more">{ui.more}</span>
          </a>
        ))
      }
    </div>
    <p class="container-wide services-note">{ui.note}</p>
  </section>

  <TrainerCard />

  <section class="services-cta section" aria-labelledby="cta-title">
    <div class="container-wide cta-inner">
      <h2 id="cta-title">{ui.ctaTitle}</h2>
      <p>{ui.ctaText}</p>
      <a
        class="services-button services-button-primary"
        href={`mailto:info@alephinnovation.com?subject=${encodeURIComponent(ui.mailSubject)}`}
      >
        info@alephinnovation.com
      </a>
      <p class="cta-location">{ui.ctaLocation}</p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  @import "../styles/training.css";
</style>
