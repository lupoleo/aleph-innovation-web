---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { getLang, localizePath } from "../i18n";

const lang = getLang(Astro);
const l = (path: string) => localizePath(path, lang);

const content = {
  en: {
    meta: {
      title: "Services — Aleph Innovation",
      description:
        "Applied AI projects, environmental monitoring and AI training for public bodies and companies in Malta and the EU. Fixed-price proposals, evidence-based delivery, from Gozo.",
    },
    services: [
      {
        number: "01",
        id: "applied-ai",
        domain: "APPLIED AI PROJECTS",
        title: "Feasibility studies, prototypes and evaluations",
        lead:
          "You have a process, a set of documents or a collection of images, and a question: can AI handle this reliably, and at what cost? We answer it with evidence, not demos.",
        items: [
          "Feasibility studies with a clear recommendation: proceed, narrow, collect more data or stop",
          "Working prototypes with a browser-based review interface for your staff",
          "Fair comparison of approaches: general-purpose AI models, custom classifiers, retrieval",
          "Document copilots (retrieval-augmented AI) over manuals, procedures and FAQs",
          "Agentic workflows where AI prepares and a named person decides",
        ],
        format: "Fixed-price project, typically 6 to 12 weeks",
        price: "From €15,000",
        audience: "Public bodies, hospitals, SMEs in Malta and across the EU (remote delivery)",
      },
      {
        number: "02",
        id: "environmental-monitoring",
        domain: "ENVIRONMENTAL MONITORING",
        title: "Early, verified signals for coast and groundwater",
        lead:
          "Field sensors, open public data and satellite imagery, checked by AI agents and delivered as a documented evidence pack to the person who decides.",
        items: [
          "Pilot on one site: sensor installation, monitoring and a final evidence report",
          "Validated, corroborated alerts with fewer false alarms",
          "Monthly evidence reports and a map-based view of your site",
          "Risk assessments built on our published Gozo risk register",
        ],
        format: "3 to 6 month pilot, then a monthly service per site",
        price: "Pilot from €3,000 · service from €300 per site per month",
        audience: "Local councils, public agencies, hotels and beach concessions, marinas, aquaculture",
      },
      {
        number: "03",
        id: "training-advisory",
        domain: "AI TRAINING AND ADVISORY",
        title: "Practical AI adoption for your team",
        lead:
          "Hands-on sessions and short assessments that help your team use AI safely and productively, and decide where it is worth investing.",
        items: [
          "Half-day and full-day workshops, delivered on site in Malta and Gozo or online",
          "AI adoption assessment: where AI fits in your processes, with a costed plan",
          "The EU AI Act in practice: what applies to your use cases",
          "Technical scope for digitalisation projects that may qualify for Maltese co-funding schemes",
        ],
        format: "Workshop or 1 to 2 week assessment",
        price: "Workshops from €1,500",
        audience: "SMEs, professional firms, business associations, universities, research groups and individuals",
        links: [
          { label: "Training for companies", href: "/services/training/companies/" },
          { label: "Training for universities and research", href: "/services/training/universities/" },
          { label: "Courses for individuals", href: "/services/training/individuals/" },
          { label: "All training offers", href: "/services/training/" },
        ],
      },
    ],
    steps: [
      { title: "Initial call", text: "A free 30-minute conversation about your problem, your data and your constraints." },
      { title: "Written proposal", text: "Scope, deliverables, schedule and a fixed price. No open-ended billing." },
      { title: "Delivery with evidence", text: "Test data kept separate from the start, results frozen before final testing, every result traceable." },
      { title: "Handover", text: "Your data, code and reports in open formats, with instructions to run and extend them." },
    ],
    principles: [
      "A named person always takes the final decision",
      "Honest measurement: accuracy, coverage and errors reported separately",
      "Data hosted in the EU, processed under GDPR",
      "Open formats and full handover, no lock-in",
    ],
    ui: {
      eyebrow: "Services",
      title: "Applied AI,",
      titleAccent: "engineered as a system.",
      lead: "The same engineering that drives our research projects is available for your organisation: auditable AI, measured honestly, with people in charge of every decision.",
      book: "Book a free 30-minute call",
      mailSubject: "Initial call",
      how: "How we work",
      lines: "Service lines",
      format: "Format",
      price: "Indicative price",
      for: "For",
      note: "Prices exclude VAT. Every engagement starts with a written, fixed-price proposal based on your scope.",
      processTitle: "From question to evidence.",
      proofEyebrow: "See the work",
      proofTitle: "Our research is public.",
      proofText: "Explore the Gozo Risk Map and the engineering wiki to see how we design, document and test AI systems before we offer them to clients.",
      riskMap: "Gozo Risk Map",
      envWiki: "Environmental Monitoring wiki",
      apWiki: "Agentic Portfolio wiki",
      ctaTitle: "Have a problem AI might solve?",
      ctaText: "Tell us about it in a few lines. We reply within two working days.",
      ctaLocation: "Gozo, Malta · working on site in Malta and remotely across the EU",
      catalog: "Services",
      orgDescription: "Applied AI projects, environmental monitoring and AI training for public bodies and companies in Malta and the EU.",
    },
  },
  it: {
    meta: {
      title: "Servizi — Aleph Innovation",
      description:
        "Progetti di IA applicata, monitoraggio ambientale e formazione sull'IA per enti pubblici e aziende a Malta e nell'UE. Proposte a prezzo fisso e risultati basati su evidenze, da Gozo.",
    },
    services: [
      {
        number: "01",
        id: "applied-ai",
        domain: "PROGETTI DI IA APPLICATA",
        title: "Studi di fattibilità, prototipi e valutazioni",
        lead:
          "Avete un processo, un insieme di documenti o una raccolta di immagini, e una domanda: l'IA può gestirli in modo affidabile, e a quale costo? Rispondiamo con evidenze, non con demo.",
        items: [
          "Studi di fattibilità con una raccomandazione chiara: procedere, restringere il perimetro, raccogliere altri dati o fermarsi",
          "Prototipi funzionanti con un'interfaccia di revisione via browser per il vostro personale",
          "Confronto imparziale tra approcci: modelli di IA generalisti, classificatori su misura, retrieval",
          "Copiloti documentali (IA con retrieval) su manuali, procedure e FAQ",
          "Flussi agentici in cui l'IA prepara e una persona identificata decide",
        ],
        format: "Progetto a prezzo fisso, in genere da 6 a 12 settimane",
        price: "Da 15.000 €",
        audience: "Enti pubblici, ospedali, PMI a Malta e in tutta l'UE (anche da remoto)",
      },
      {
        number: "02",
        id: "environmental-monitoring",
        domain: "MONITORAGGIO AMBIENTALE",
        title: "Segnali tempestivi e verificati per costa e falde",
        lead:
          "Sensori sul campo, dati pubblici aperti e immagini satellitari, verificati da agenti IA e consegnati come dossier di evidenze documentato alla persona che decide.",
        items: [
          "Pilota su un sito: installazione dei sensori, monitoraggio e report finale di evidenze",
          "Allerte validate e corroborate, con meno falsi allarmi",
          "Report mensili di evidenze e una vista su mappa del vostro sito",
          "Valutazioni del rischio basate sul nostro registro pubblico dei rischi di Gozo",
        ],
        format: "Pilota da 3 a 6 mesi, poi un servizio mensile per sito",
        price: "Pilota da 3.000 € · servizio da 300 € al mese per sito",
        audience: "Consigli locali, enti pubblici, hotel e stabilimenti balneari, porti turistici, acquacoltura",
      },
      {
        number: "03",
        id: "training-advisory",
        domain: "FORMAZIONE E CONSULENZA IA",
        title: "Adozione concreta dell'IA per il vostro team",
        lead:
          "Sessioni pratiche e assessment brevi che aiutano il vostro team a usare l'IA in modo sicuro e produttivo, e a decidere dove vale la pena investire.",
        items: [
          "Workshop di mezza giornata e di una giornata, in sede a Malta e Gozo oppure online",
          "Assessment di adozione dell'IA: dove si inserisce nei vostri processi, con un piano dei costi",
          "L'AI Act europeo in pratica: cosa si applica ai vostri casi d'uso",
          "Perimetro tecnico per progetti di digitalizzazione che possono accedere ai programmi di cofinanziamento maltesi",
        ],
        format: "Workshop o assessment da 1 a 2 settimane",
        price: "Workshop da 1.500 €",
        audience: "PMI, studi professionali, associazioni di categoria, università, gruppi di ricerca e privati",
        links: [
          { label: "Formazione per le aziende", href: "/services/training/companies/" },
          { label: "Formazione per università e ricerca", href: "/services/training/universities/" },
          { label: "Corsi per privati", href: "/services/training/individuals/" },
          { label: "Tutte le offerte di formazione", href: "/services/training/" },
        ],
      },
    ],
    steps: [
      { title: "Call iniziale", text: "Una conversazione gratuita di 30 minuti sul vostro problema, sui vostri dati e sui vostri vincoli." },
      { title: "Proposta scritta", text: "Perimetro, deliverable, tempi e un prezzo fisso. Nessuna fatturazione a consumo senza limiti." },
      { title: "Realizzazione con evidenze", text: "Dati di test separati fin dall'inizio, risultati congelati prima del test finale, ogni risultato tracciabile." },
      { title: "Consegna", text: "I vostri dati, il codice e i report in formati aperti, con le istruzioni per eseguirli ed estenderli." },
    ],
    principles: [
      "La decisione finale spetta sempre a una persona identificata",
      "Misure oneste: accuratezza, copertura ed errori riportati separatamente",
      "Dati ospitati nell'UE e trattati secondo il GDPR",
      "Formati aperti e consegna completa, nessun vincolo di dipendenza",
    ],
    ui: {
      eyebrow: "Servizi",
      title: "IA applicata,",
      titleAccent: "progettata come un sistema.",
      lead: "La stessa ingegneria che guida i nostri progetti di ricerca è a disposizione della vostra organizzazione: IA verificabile, misurata con onestà, con le persone al comando di ogni decisione.",
      book: "Prenota una call gratuita di 30 minuti",
      mailSubject: "Call iniziale",
      how: "Come lavoriamo",
      lines: "Linee di servizio",
      format: "Formato",
      price: "Prezzo indicativo",
      for: "Per chi",
      note: "Prezzi IVA esclusa. Ogni incarico parte da una proposta scritta a prezzo fisso, basata sul vostro perimetro.",
      processTitle: "Dalla domanda alle evidenze.",
      proofEyebrow: "Guarda il lavoro",
      proofTitle: "La nostra ricerca è pubblica.",
      proofText: "Esplorate la Mappa dei rischi di Gozo e la Wiki tecnica per vedere come progettiamo, documentiamo e testiamo i sistemi di IA prima di proporli ai clienti.",
      riskMap: "Mappa dei rischi di Gozo",
      envWiki: "Wiki Monitoraggio ambientale",
      apWiki: "Wiki Agentic Portfolio",
      ctaTitle: "Avete un problema che l'IA potrebbe risolvere?",
      ctaText: "Raccontatecelo in poche righe. Rispondiamo entro due giorni lavorativi.",
      ctaLocation: "Gozo, Malta · in sede a Malta e da remoto in tutta l'UE",
      catalog: "Servizi",
      orgDescription: "Progetti di IA applicata, monitoraggio ambientale e formazione sull'IA per enti pubblici e aziende a Malta e nell'UE.",
    },
  },
}[lang];

const { services, steps, principles, ui } = content;
const pageURL = `https://alephinnovation.com${l("/services/")}`;
const mailto = `mailto:info@alephinnovation.com?subject=${encodeURIComponent(ui.mailSubject)}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Aleph Innovation",
  url: pageURL,
  email: "info@alephinnovation.com",
  inLanguage: lang,
  description: ui.orgDescription,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ghajnsielem",
    addressRegion: "Gozo",
    addressCountry: "MT",
  },
  areaServed: ["Malta", "European Union"],
  sameAs: ["https://www.linkedin.com/company/alephinnovation/"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: ui.catalog,
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.lead,
        url: `${pageURL}#${service.id}`,
      },
    })),
  },
};
---

<BaseLayout title={content.meta.title} description={content.meta.description}>
  <section class="services-hero section" aria-labelledby="services-title">
    <div class="container-wide">
      <p class="eyebrow">{ui.eyebrow}</p>
      <h1 id="services-title">
        {ui.title}
        <span class="text-gradient">{ui.titleAccent}</span>
      </h1>
      <p class="lead">{ui.lead}</p>
      <div class="services-hero-actions">
        <a class="services-button services-button-primary" href={mailto}>
          {ui.book}
        </a>
        <a class="services-button" href="#how-we-work">{ui.how}</a>
      </div>
    </div>
  </section>

  <section class="services-list section-compact" aria-label={ui.lines}>
    <div class="container-wide services-grid">
      {
        services.map((service) => (
          <article class="service-card" id={service.id}>
            <div class="service-topline">
              <span>{service.domain}</span>
              <span>{service.number}</span>
            </div>

            <h2>{service.title}</h2>
            <p class="service-lead">{service.lead}</p>

            <ul class="service-items">
              {service.items.map((item) => <li>{item}</li>)}
            </ul>

            <dl class="service-facts">
              <div>
                <dt>{ui.format}</dt>
                <dd>{service.format}</dd>
              </div>
              <div>
                <dt>{ui.price}</dt>
                <dd class="service-price">{service.price}</dd>
              </div>
              <div>
                <dt>{ui.for}</dt>
                <dd>{service.audience}</dd>
              </div>
            </dl>

            {service.links && (
              <div class="service-links">
                {service.links.map((link) => (
                  <a href={l(link.href)}>
                    {link.label} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
    <p class="container-wide services-note">{ui.note}</p>
  </section>

  <section
    id="how-we-work"
    class="services-process section"
    aria-labelledby="process-title"
  >
    <div class="container-wide process-layout">
      <div>
        <p class="eyebrow">{ui.how}</p>
        <h2 id="process-title">{ui.processTitle}</h2>
        <ul class="principles">
          {principles.map((principle) => <li>{principle}</li>)}
        </ul>
      </div>

      <ol class="process-steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="process-index">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="services-proof section-compact" aria-labelledby="proof-title">
    <div class="container-wide proof-card">
      <div>
        <p class="eyebrow">{ui.proofEyebrow}</p>
        <h2 id="proof-title">{ui.proofTitle}</h2>
        <p>{ui.proofText}</p>
      </div>
      <div class="proof-links">
        <a href="/gozo-risk-map/">{ui.riskMap} <span aria-hidden="true">↗</span></a>
        <a href={l("/wiki/environmental-monitoring/")}>{ui.envWiki} <span aria-hidden="true">↗</span></a>
        <a href={l("/wiki/agentic-portfolio/")}>{ui.apWiki} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="services-cta section" aria-labelledby="cta-title">
    <div class="container-wide cta-inner">
      <h2 id="cta-title">{ui.ctaTitle}</h2>
      <p>{ui.ctaText}</p>
      <a class="services-button services-button-primary" href={mailto}>
        info@alephinnovation.com
      </a>
      <p class="cta-location">{ui.ctaLocation}</p>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <Footer />
</BaseLayout>

<style>
  .services-hero h1 {
    max-width: 16ch;
    margin: 0 0 var(--space-6);

    font-size: clamp(2.6rem, 5.4vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .services-hero h1 span {
    display: block;
  }

  .services-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);

    margin-top: var(--space-8);
  }

  .services-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 2.9rem;
    padding-inline: var(--space-6);

    border: 1px solid var(--aleph-border-strong);
    border-radius: var(--radius-pill);

    background: rgba(7, 27, 48, 0.74);

    color: var(--aleph-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .services-button:hover {
    border-color: rgba(22, 201, 216, 0.56);
    transform: translateY(-1px);
  }

  .services-button-primary {
    border-color: transparent;
    background: var(--aleph-gradient-primary);
    color: var(--aleph-text-inverse);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .service-card {
    display: flex;
    flex-direction: column;

    padding: clamp(1.4rem, 2.4vw, 2rem);

    border: 1px solid var(--aleph-border);
    border-radius: var(--radius-xl);

    background: var(--aleph-gradient-surface);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);

    scroll-margin-top: 6rem;
  }

  .service-topline {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);

    margin-bottom: var(--space-6);

    color: var(--aleph-green);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
  }

  .service-topline span:last-child {
    color: var(--aleph-text-muted);
  }

  .service-card h2 {
    margin: 0 0 var(--space-4);

    font-size: clamp(1.35rem, 1.9vw, 1.7rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .service-lead {
    margin: 0 0 var(--space-6);

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .service-items {
    display: grid;
    gap: var(--space-3);

    margin: 0 0 var(--space-8);
    padding: 0;

    list-style: none;
  }

  .service-items li {
    position: relative;

    padding-left: 1.25rem;

    color: var(--aleph-text-primary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .service-items li::before {
    content: "";

    position: absolute;
    left: 0;
    top: 0.6em;

    width: 0.45rem;
    height: 1px;

    background: var(--aleph-cyan);
  }

  .service-facts {
    display: grid;
    gap: var(--space-4);

    margin: auto 0 0;
    padding-top: var(--space-6);

    border-top: 1px solid var(--aleph-border-subtle);
  }

  .service-facts dt {
    margin-bottom: 0.2rem;

    color: var(--aleph-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-facts dd {
    margin: 0;

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .service-facts .service-price {
    color: var(--aleph-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .service-links {
    display: grid;
    gap: var(--space-2);

    margin-top: var(--space-6);
  }

  .service-links a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);

    padding: var(--space-3) var(--space-4);

    border: 1px solid var(--aleph-border-subtle);
    border-radius: var(--radius-md);

    color: var(--aleph-text-primary);
    font-size: var(--font-size-sm);
  }

  .service-links a:hover {
    border-color: rgba(22, 201, 216, 0.4);
    color: var(--aleph-cyan);
  }

  .services-note {
    margin-top: var(--space-6);

    color: var(--aleph-text-muted);
    font-size: var(--font-size-xs);
  }

  .services-process {
    border-top: 1px solid rgba(90, 180, 220, 0.08);
  }

  .process-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .process-layout h2 {
    margin: 0 0 var(--space-8);

    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .principles {
    display: grid;
    gap: var(--space-3);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .principles li {
    padding: var(--space-3) var(--space-4);

    border: 1px solid var(--aleph-border-subtle);
    border-radius: var(--radius-md);

    background: rgba(7, 27, 48, 0.5);

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
  }

  .process-steps {
    display: grid;
    gap: var(--space-4);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .process-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);

    padding: var(--space-6);

    border: 1px solid var(--aleph-border);
    border-radius: var(--radius-lg);

    background: var(--aleph-gradient-surface);
  }

  .process-index {
    color: var(--aleph-cyan);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .process-steps h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-lg);
  }

  .process-steps p {
    margin: 0;

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .proof-card {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-8);
    align-items: center;

    padding: clamp(1.6rem, 3vw, 2.6rem);

    border: 1px solid var(--aleph-border);
    border-radius: var(--radius-xl);

    background: rgba(7, 27, 48, 0.55);
  }

  .proof-card h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }

  .proof-card p {
    margin: 0;
    color: var(--aleph-text-secondary);
    line-height: var(--line-height-body);
