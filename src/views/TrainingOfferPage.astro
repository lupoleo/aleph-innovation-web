---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import TrainerCard from "../components/TrainerCard.astro";
import { getPublishedOffers, type TrainingOffer } from "../data/training";
import { getLang, localizePath } from "../i18n";

const lang = getLang(Astro);
const l = (path: string) => localizePath(path, lang);
const publishedOffers = getPublishedOffers(lang);

const ui = {
  en: {
    services: "Services",
    training: "AI training",
    book: "Book a free 30-minute call",
    prices: "Packages and prices",
    curriculum: "Curriculum",
    leave: "You leave with",
    terms: "Delivery and terms",
    proposal: "Every engagement starts with a written, fixed-price proposal.",
    other: "Other training offers",
    all: "All services",
    ctaTitle: "Ready to start?",
    ctaText: "Tell us what you need in a few lines. We reply within two working days.",
    ctaLocation: "Gozo, Malta · on site in Malta and Gozo, live online across the EU",
  },
  it: {
    services: "Servizi",
    training: "Formazione AI",
    book: "Prenota una call gratuita di 30 minuti",
    prices: "Pacchetti e prezzi",
    curriculum: "Programma",
    leave: "Alla fine avrai",
    terms: "Modalità e condizioni",
    proposal: "Ogni incarico parte da una proposta scritta a prezzo fisso.",
    other: "Altre offerte di formazione",
    all: "Tutti i servizi",
    ctaTitle: "Iniziamo?",
    ctaText: "Descrivi in poche righe di cosa hai bisogno. Rispondiamo entro due giorni lavorativi.",
    ctaLocation: "Gozo, Malta · in sede a Malta e Gozo, live online in tutta l'UE",
  },
}[lang];

// The page route passes the offer slug; the text comes from the page language.
const { offer: routeOffer } = Astro.props as { offer: TrainingOffer };
const offer = publishedOffers.find((o) => o.slug === routeOffer.slug) ?? routeOffer;
const others = publishedOffers.filter((o) => o.slug !== offer.slug);
const mailto = `mailto:info@alephinnovation.com?subject=${encodeURIComponent(offer.mailSubject)}`;
const columns = [...offer.priceColumns, ...(offer.extraColumns ?? [])];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: offer.eyebrow,
  description: offer.lead,
  url: `https://alephinnovation.com${l(`/services/training/${offer.slug}/`)}`,
  inLanguage: lang,
  provider: {
    "@type": "ProfessionalService",
    name: "Aleph Innovation",
    url: "https://alephinnovation.com/",
  },
  areaServed: ["Malta", "European Union"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: offer.eyebrow,
    itemListElement: offer.packages.map((p) => ({
      "@type": "Offer",
      name: p.name,
      price: p.price.replace(/[^0-9]/g, ""),
      priceCurrency: "EUR",
    })),
  },
};
---

<BaseLayout
  title={`${offer.eyebrow} — Aleph Innovation`}
  description={offer.lead}
>
  <section class="training-hero section" aria-labelledby="training-title">
    <div class="container-wide">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={l("/services/")}>{ui.services}</a>
        <span aria-hidden="true">/</span>
        <a href={l("/services/training/")}>{ui.training}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{offer.cardTitle}</span>
      </nav>
      <p class="eyebrow">{offer.eyebrow}</p>
      <h1 id="training-title">{offer.title}</h1>
      <p class="lead">{offer.lead}</p>
      <p class="training-why">{offer.why}</p>
      <div class="training-actions">
        <a class="services-button services-button-primary" href={mailto}>{ui.book}</a>
        <a class="services-button" href="#prices">{ui.prices}</a>
        <a class="services-button" href="#curriculum">{ui.curriculum}</a>
      </div>
    </div>
  </section>

  <section id="prices" class="section-compact" aria-labelledby="prices-title">
    <div class="container-wide">
      <h2 id="prices-title" class="training-h2">{ui.prices}</h2>
      <p class="training-intro">{offer.priceIntro}</p>
      <div class="table-scroll">
        <table class="training-table">
          <thead>
            <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {
              offer.packages.map((p) => (
                <tr>
                  <th scope="row">{p.name}</th>
                  <td>{p.duration}</td>
                  <td>{p.group}</td>
                  <td>{p.audience}</td>
                  <td class="price">{p.price}</td>
                  {p.extra && Object.values(p.extra).map((v) => <td class="price">{v}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <ul class="training-notes">
        {offer.priceNotes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section id="curriculum" class="section-compact" aria-labelledby="curriculum-title">
    <div class="container-wide">
      <h2 id="curriculum-title" class="training-h2">{ui.curriculum}</h2>
      <div class="curriculum-grid">
        {
          offer.curriculum.map((block) => (
            <article class="curriculum-card">
              <h3>{block.title}</h3>
              <ol>
                {block.modules.map((m) => <li>{m}</li>)}
              </ol>
              <p class="outcome">
                <span>{ui.leave}</span>
                {block.outcome}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-compact" aria-labelledby="terms-title">
    <div class="container-wide">
      <h2 id="terms-title" class="training-h2">{ui.terms}</h2>
      {
        offer.termsTable && (
          <>
            <p class="training-intro">{offer.termsTable.caption}</p>
            <div class="table-scroll">
              <table class="training-table">
                <thead>
                  <tr>{offer.termsTable.head.map((h) => <th scope="col">{h}</th>)}</tr>
                </thead>
                <tbody>
                  {offer.termsTable.rows.map((r) => (
                    <tr>
                      <th scope="row">{r[0]}</th>
                      {r.slice(1).map((c) => <td>{c}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }
      <dl class="terms-list">
        {
          offer.terms.map((t) => (
            <div>
              <dt>{t.label}</dt>
              <dd>{t.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="services-note">{ui.proposal}</p>
    </div>
  </section>

  <TrainerCard />

  <section class="section-compact" aria-labelledby="other-title">
    <div class="container-wide other-offers">
      <h2 id="other-title" class="training-h2">{ui.other}</h2>
      <div class="other-links">
        {
          others.map((o) => (
            <a href={l(`/services/training/${o.slug}/`)}>
              {o.cardTitle} <span aria-hidden="true">→</span>
            </a>
          ))
        }
        <a href={l("/services/")}>{ui.all} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="services-cta section" aria-labelledby="cta-title">
    <div class="container-wide cta-inner">
      <h2 id="cta-title">{ui.ctaTitle}</h2>
      <p>{ui.ctaText}</p>
      <a class="services-button services-button-primary" href={mailto}>info@alephinnovation.com</a>
      <p class="cta-location">{ui.ctaLocation}</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Footer />
</BaseLayout>

<style>
  @import "../styles/training.css";
</style>
