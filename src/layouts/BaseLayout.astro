---
import Header from "../components/Header.astro";
import { getLang, alternatePaths, languages, langCodes, isEnglishOnlyInMaltese } from "../i18n";

const lang = getLang(Astro);

const defaultDescription = {
  en: "Aleph Innovation is an AI venture in formation based in Gozo, Malta, focused on the engineering of Agentic AI systems that combine deterministic software with probabilistic AI.",
  it: "Aleph Innovation è una realtà di ricerca e sviluppo sull'intelligenza artificiale in fase di costituzione a Gozo, Malta, specializzata nell'ingegneria di sistemi di AI agentica che uniscono software deterministico e AI probabilistica.",
  mt: "Aleph Innovation hija proġett ta' riċerka u żvilupp fl-AI li qed jitwaqqaf f'Għawdex, Malta, u li jfassal sistemi ta' Agentic AI li jgħaqqdu softwer deterministiku ma' AI probabilistika.",
}[lang];

const imageAlt = {
  en: "Aleph Innovation — Engineering Agentic AI Systems",
  it: "Aleph Innovation — Ingegneria di sistemi di AI agentica",
  mt: "Aleph Innovation — Inġinerija ta' sistemi ta' Agentic AI",
}[lang];

const {
  title = "Aleph Innovation",
  description = defaultDescription,
  canonicalPath = Astro.url.pathname,
  socialImage = "/og-image.png",
} = Astro.props;

// Pages that are not translated into Maltese show the English text under
// /mt/: they name the English page as canonical and are not offered as a
// Maltese alternate.
const englishOnly = isEnglishOnlyInMaltese(canonicalPath);
const alternates = alternatePaths(canonicalPath);
const canonicalURL = new URL(
  lang === "mt" && englishOnly ? alternates.en : canonicalPath,
  Astro.site
);
const socialImageURL = new URL(socialImage, Astro.site);

// hreflang alternates: every page exists in English, Italian (/it/) and
// Maltese (/mt/), except the English-only pages above.
const hreflangCodes = langCodes.filter((code) => !(code === "mt" && englishOnly));
const alternateURLs = hreflangCodes.map((code) => ({
  code,
  href: new URL(alternates[code], Astro.site),
}));
const otherLocales = langCodes
  .filter((code) => code !== lang)
  .map((code) => languages[code].ogLocale);
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {alternateURLs.map((alt) => (
    <link rel="alternate" hreflang={alt.code} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Aleph Innovation" />
  <meta property="og:locale" content={languages[lang].ogLocale} />
  {otherLocales.map((locale) => (
    <meta property="og:locale:alternate" content={locale} />
  ))}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={socialImageURL} />
  <meta
    property="og:image:alt"
    content={imageAlt}
  />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  <meta
    name="twitter:image:alt"
    content={imageAlt}
  />

  <meta name="theme-color" content="#020b18" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  </head>

  <body>
    <div class="aleph-background" aria-hidden="true"></div>
    <div class="aleph-network-grid" aria-hidden="true"></div>

    <div class="site-root">
     <Header />
      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  @import "../styles/backgrounds.css";
</style>