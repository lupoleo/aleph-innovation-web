---
import { trainer } from "../data/trainer";
---

<section class="section-compact" aria-labelledby="trainer-title">
  <div class="container-wide">
    <div class="trainer-card">
      <img
        class="trainer-photo"
        src={trainer.photo}
        alt={trainer.name}
        width="640"
        height="640"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="trainer-eyebrow">Your trainer</p>
        <h2 id="trainer-title" class="trainer-name">{trainer.name}</h2>
        <p class="trainer-text">{trainer.short}</p>
        <a class="trainer-more" href={`/about/${trainer.slug}/`}>Full profile →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .trainer-card {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    padding: clamp(1.3rem, 2.4vw, 2rem);
    border: 1px solid var(--aleph-border);
    border-radius: var(--radius-xl);
    background: var(--aleph-gradient-surface);
  }

  .trainer-photo {
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--aleph-border-strong);
  }

  .trainer-eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--aleph-green);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .trainer-name {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.3rem, 1.8vw, 1.6rem);
  }

  .trainer-text {
    max-width: 52rem;
    margin: 0 0 var(--space-4);
    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .trainer-more {
    color: var(--aleph-cyan);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 640px) {
    .trainer-card {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .trainer-photo {
      width: 7rem;
      height: 7rem;
    }
  }
</style>
