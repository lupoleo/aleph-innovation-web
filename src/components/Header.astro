---
const navItems = [
  { label: "Paradigm", href: "/#paradigm" },
  { label: "Projects", href: "/#projects" },
  { label: "Agentic Portfolio", href: "/#agentic-portfolio" },
  { label: "Wiki", href: "/#wiki" },
  { label: "Fund", href: "/#fund-project" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" }
];
---

<header class="site-header">
  <div class="container-wide header-inner">
    <a
      class="brand"
      href="/"
      aria-label="Aleph Innovation home"
    >
      <span class="brand-mark" aria-hidden="true">
        <span class="brand-mark-primary"></span>
        <span class="brand-mark-secondary"></span>
      </span>

      <span class="brand-copy">
        <span class="brand-name">ALEPH</span>
        <span class="brand-subtitle">INNOVATION</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open navigation menu">
        <span class="mobile-nav-label">Menu</span>

        <span class="mobile-nav-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>

      <nav class="mobile-nav-panel" aria-label="Mobile navigation">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>

        <a class="mobile-wiki-link" href="/wiki/">
          Engineering Wiki
        </a>
      </nav>
    </details>

    <a class="header-cta" href="/#wiki">
      Engineering Wiki
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);

    border-bottom: 1px solid rgba(90, 180, 220, 0.08);

    background:
      linear-gradient(
        180deg,
        rgba(2, 11, 24, 0.94),
        rgba(2, 11, 24, 0.82)
      );

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-8);

    min-height: 4.8rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);

    min-width: max-content;
  }

  .brand-mark {
    position: relative;

    width: 2rem;
    height: 2rem;

    display: block;
  }

  .brand-mark-primary,
  .brand-mark-secondary {
    position: absolute;
    display: block;

    border-radius: 0.35rem;
  }

  .brand-mark-primary {
    width: 0.72rem;
    height: 1.9rem;

    left: 0.24rem;
    top: 0.02rem;

    transform: rotate(28deg);

    background:
      linear-gradient(
        180deg,
        var(--aleph-green),
        var(--aleph-cyan)
      );

    box-shadow:
      0 0 18px rgba(85, 214, 158, 0.12);
  }

  .brand-mark-secondary {
    width: 0.68rem;
    height: 1.35rem;

    right: 0.2rem;
    bottom: 0.05rem;

    transform: rotate(-42deg);

    background:
      linear-gradient(
        180deg,
        var(--aleph-blue-bright),
        var(--aleph-blue)
      );

    box-shadow:
      0 0 18px rgba(49, 92, 255, 0.16);
  }

  .brand-copy {
    display: grid;
    gap: 0.05rem;

    line-height: 1;
  }

  .brand-name {
    font-size: 0.94rem;
    font-weight: var(--font-weight-semibold);

    letter-spacing: 0.28em;
    color: var(--aleph-text-primary);
  }

  .brand-subtitle {
    font-size: 0.63rem;
    font-weight: var(--font-weight-medium);

    letter-spacing: 0.24em;

    color: var(--aleph-green);
  }

  .desktop-nav {
    justify-self: center;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .desktop-nav li {
    margin: 0;
  }

  .desktop-nav a {
    position: relative;

    display: inline-flex;
    align-items: center;

    min-height: 2.6rem;

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);

    color: var(--aleph-text-secondary);

    transition:
      color var(--duration-fast) var(--ease-standard);
  }

  .desktop-nav a::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 0.2rem;

    height: 1px;

    transform: scaleX(0);
    transform-origin: center;

    background: var(--aleph-gradient-primary);

    transition:
      transform var(--duration-base) var(--ease-emphasized);
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: var(--aleph-text-primary);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 2.7rem;

    padding-inline: var(--space-4);

    border: 1px solid var(--aleph-border-strong);
    border-radius: var(--radius-pill);

    background:
      linear-gradient(
        180deg,
        rgba(13, 41, 68, 0.78),
        rgba(7, 27, 48, 0.74)
      );

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    color: var(--aleph-text-primary);

    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.025);

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .header-cta:hover {
    border-color: rgba(22, 201, 216, 0.56);

    box-shadow:
      0 0 26px rgba(22, 201, 216, 0.08),
      inset 0 1px rgba(255, 255, 255, 0.03);

    transform: translateY(-1px);
  }

  .mobile-nav {
    position: relative;
    display: none;
    justify-self: end;
  }

  .mobile-nav summary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    min-height: 2.7rem;
    padding-inline: var(--space-4);

    border: 1px solid var(--aleph-border-strong);
    border-radius: var(--radius-pill);

    background: rgba(7, 27, 48, 0.82);

    color: var(--aleph-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary:focus-visible {
    outline: 2px solid var(--aleph-cyan);
    outline-offset: 3px;
  }

  .mobile-nav-icon {
    display: grid;
    gap: 3px;
    width: 1rem;
  }

  .mobile-nav-icon span {
    display: block;
    width: 100%;
    height: 1px;

    background: currentColor;
  }

  .mobile-nav-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;

    width: min(20rem, calc(100vw - 2rem));
    padding: 0.75rem;

    border: 1px solid var(--aleph-border-strong);
    border-radius: var(--radius-lg);

    background: rgba(2, 11, 24, 0.98);
    box-shadow: var(--shadow-md);
  }

  .mobile-nav-panel ul {
    display: grid;
    gap: 0.15rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .mobile-nav-panel li {
    margin: 0;
  }

  .mobile-nav-panel a {
    display: block;

    padding: 0.8rem 0.9rem;

    border-radius: var(--radius-md);

    color: var(--aleph-text-secondary);
    font-size: var(--font-size-sm);
  }

  .mobile-nav-panel a:hover,
  .mobile-nav-panel a:focus-visible {
    background: rgba(22, 201, 216, 0.07);
    color: var(--aleph-text-primary);
  }

  .mobile-wiki-link {
    margin-top: 0.5rem;

    border: 1px solid rgba(22, 201, 216, 0.22);

    color: var(--aleph-green) !important;
  }

  @media (max-width: 1100px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-nav {
      display: block;
      grid-column: 3;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      min-height: 4.25rem;
      gap: var(--space-4);
    }

    .brand-mark {
      width: 1.75rem;
      height: 1.75rem;
    }

    .brand-name {
      font-size: 0.82rem;
    }

    .brand-subtitle {
      font-size: 0.56rem;
    }

    .header-cta {
      min-height: 2.35rem;
      padding-inline: var(--space-3);
      font-size: var(--font-size-xs);
    }

    .mobile-nav-panel {
      width: 15rem;
      max-width: calc(100vw - 2rem);
      right: 0;
      left: auto;
      padding: 0.65rem;
    }

    .mobile-nav-panel ul {
      gap: 0;
    }

    .mobile-nav-panel a {
      padding: 0.52rem 0.65rem;
    }

    .mobile-wiki-link {
      margin-top: 0.45rem;
    }
  }

  @media (max-width: 470px) {
    .brand-subtitle {
      display: none;
    }

    .header-cta {
      padding-inline: var(--space-3);
    }
  }
</style>