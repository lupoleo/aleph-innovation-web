---
/**
 * Agentic Portfolio — Stage 4.0 Architecture Map
 * Source model: STAGE_4_0_ARCHITECTURE.md
 * Native HTML/CSS, responsive, no client-side JS.
 */
---

<section class="s4-map" aria-labelledby="s4-map-title">
  <header class="map-head">
    <div>
      <p class="kicker">STAGE 4.0 · TRUE AGENTIC PORTFOLIO E2E</p>
      <h2 id="s4-map-title">Two sources. One auditable decision path.</h2>
    </div>
    <p class="summary">
      Real portfolio state and the external Scanner universe converge into a
      Research Watch Universe. AI interprets evidence inside validated contracts;
      deterministic finance owns risk and construction; execution remains human.
    </p>
  </header>

  <div class="frame">
    <section class="dual-source" aria-label="Stage 4 upstream sources">
      <div class="source-column">
        <p class="column-label">REAL PORTFOLIO SOURCE</p>
        <article class="node">
          <em>FINECO · AUTHORITATIVE</em>
          <strong>Portfolio Snapshot</strong>
          <small>Real positions, cash and broker-visible account state.</small>
        </article>
        <div class="down">↓</div>
        <article class="node">
          <em>PYTHON · DETERMINISTIC</em>
          <strong>Portfolio Analysis &amp; Risk State</strong>
          <small>Quantitative analytics, exposures and canonical risk context.</small>
        </article>
        <div class="down">↓</div>
        <article class="node">
          <em>WATCH</em>
          <strong>Portfolio Watch Set</strong>
          <small>Current positions remain observable even when not eligible as new Scanner candidates.</small>
        </article>
      </div>

      <div class="source-column">
        <p class="column-label">EXTERNAL DISCOVERY SOURCE</p>
        <article class="node">
          <em>PRODUCTION UNIVERSE</em>
          <strong>Exchange Listings</strong>
          <small>Broad venue universe independent of current portfolio holdings.</small>
        </article>
        <div class="down">↓</div>
        <article class="node">
          <em>SCANNER · DETERMINISTIC GATES</em>
          <strong>Identity · Eligibility · History · Liquidity</strong>
          <small>Explicit auditable gates preserve listing identity and fail closed.</small>
        </article>
        <div class="down">↓</div>
        <article class="node">
          <em>CANDIDATES</em>
          <strong>Scanner Candidate Set</strong>
          <small>Listings admissible for new-opportunity research.</small>
        </article>
      </div>
    </section>

    <div class="merge" aria-hidden="true">
      <span></span><b>∪</b><span></span>
    </div>

    <section class="layer watch-layer">
      <header>
        <b>01</b>
        <div><strong>Research Watch Universe</strong><small>SCANNER CANDIDATE SET ∪ PORTFOLIO WATCH SET · PROVENANCE PRESERVED</small></div>
      </header>
      <div class="wide-node">
        <span>NEW_CANDIDATE</span>
        <span>CURRENT_POSITION</span>
        <span>OR BOTH</span>
      </div>
    </section>

    <div class="down">↓</div>

    <section class="layer">
      <header>
        <b>02</b>
        <div><strong>Evidence &amp; Research</strong><small>SOURCE-BACKED EVIDENCE · LOCAL LLM · DETERMINISTIC VALIDATION</small></div>
      </header>

      <div class="evidence-row">
        <span>TECHNICAL</span><span>MARKET</span><span>NEWS</span><span>FUNDAMENTAL</span><span>ANALYST</span>
      </div>

      <div class="down">↓</div>

      <article class="node ai research">
        <em>RESEARCH · AI + VALIDATION</em>
        <strong>Normalized Research</strong>
        <small>Extraction and synthesis remain distinct from evidence, provenance and schema validation.</small>
      </article>
    </section>

    <div class="down">↓</div>

    <section class="layer">
      <header>
        <b>03</b>
        <div><strong>Directional Opportunity Intelligence</strong><small>COMPANY FRAME + LONG / SHORT HYPOTHESES</small></div>
      </header>

      <div class="split">
        <article class="node ai">
          <em>SHARED · DIRECTION-FREE</em>
          <strong>Company Assessment</strong>
          <small>Fundamental and expectations assessment shared per listing.</small>
        </article>

        <div class="join-arrow" aria-hidden="true">↘</div>

        <article class="node ai">
          <em>DIRECTIONAL · LONG / SHORT</em>
          <strong>Opportunity Scoring</strong>
          <small>Scores support for each hypothesis direction under versioned policy.</small>
        </article>
      </div>

      <div class="down">↓</div>

      <div class="scored">
        <article class="node">
          <em>PERSISTED</em>
          <strong>Scored Directional Hypotheses</strong>
          <small>Complete, partial, excluded or failed outcomes remain explicit.</small>
        </article>

        <div class="branch" aria-hidden="true">↙ &nbsp;&nbsp; ↘</div>

        <div class="branch-targets">
          <article class="node opportunity">
            <em>MATERIALIZATION GATE</em>
            <strong>TradeOpportunity · 0..N</strong>
            <small>Only hypotheses satisfying the accepted research, score and confidence gates materialize.</small>
          </article>

          <article class="node shadow">
            <em>MEASUREMENT ONLY</em>
            <strong>Shadow Ledger</strong>
            <small>Measures directional and index-relative outcomes; never affects decisions.</small>
          </article>
        </div>
      </div>
    </section>

    <div class="down">↓</div>

    <section class="operator-gate">
      <span>HUMAN CONTROL GATE</span>
      <strong>OPERATOR SELECTS EXACTLY ONE</strong>
      <small>Ranking and selection are separate events. No implicit batch allocator.</small>
    </section>

    <div class="down">↓</div>

    <section class="layer">
      <header>
        <b>04</b>
        <div><strong>Deterministic Portfolio Construction</strong><small>FROZEN PORTFOLIO FILTER → EXACT PROPOSAL → MARGINAL SIMULATION</small></div>
      </header>

      <div class="pipeline five">
        <article class="node"><em>FILTER</em><strong>Frozen Portfolio Filter</strong><small>Exposure, concentration, correlation, liquidity and marginal-risk gates.</small></article>
        <i>→</i>
        <article class="node"><em>SELECT</em><strong>Instrument</strong><small>Resolve the exact tradable representation.</small></article>
        <i>→</i>
        <article class="node"><em>SIZE</em><strong>Position Sizing</strong><small>Deterministic proposed size under portfolio constraints.</small></article>
        <i>→</i>
        <article class="node"><em>PROPOSE</em><strong>TradeProposal</strong><small>Side, quantity, reference price, notional, costs and constraints.</small></article>
        <i>→</i>
        <article class="node"><em>SIMULATE</em><strong>Portfolio Simulator V2</strong><small>Compare pre-trade and simulated post-trade portfolio state.</small></article>
      </div>
    </section>

    <div class="down">↓</div>

    <section class="layer">
      <header>
        <b>05</b>
        <div><strong>CIO Decision &amp; Execution Boundary</strong><small>AUDITABLE DECISION · EXECUTION PLAN · NO BROKER ORDER</small></div>
      </header>

      <div class="decision-row">
        <article class="node ai">
          <em>CIO · REASONING</em>
          <strong>CIO Decision</strong>
          <small>Qualitative thesis is evaluated alongside deterministic constraints, simulation impact and unresolved risk.</small>
        </article>
        <i>→</i>
        <article class="node">
          <em>APPROVED ONLY</em>
          <strong>ExecutionPlan</strong>
          <small>Broker-ready manual instruction. It is not an order and does not mutate real state.</small>
        </article>
      </div>

      <div class="authority">
        <span>SOFTWARE AUTHORITY</span>
        <div><u></u><b>AUTHORITY TRANSFER</b><u></u></div>
        <span>HUMAN AUTHORITY</span>
      </div>

      <div class="human-flow">
        <article class="node human">
          <em>HUMAN</em>
          <strong>Manual Execution</strong>
          <small>The operator decides whether and how the plan is actually executed.</small>
        </article>
        <i>→</i>
        <article class="node authoritative">
          <em>FINECO · AUTHORITATIVE</em>
          <strong>New Portfolio Snapshot</strong>
          <small>Only a subsequent broker-visible snapshot establishes the new real state.</small>
        </article>
        <i>→</i>
        <article class="node">
          <em>OBSERVED</em>
          <strong>Execution Outcome</strong>
          <small>Executed, partial, changed and unexecuted outcomes remain distinguishable.</small>
        </article>
      </div>
    </section>

    <section class="state-invariant">
      <span>REAL</span><b>≠</b><span>SIMULATED</span><b>≠</b><span>PROPOSED</span>
      <small>State domains remain explicit throughout the lifecycle.</small>
    </section>

    <section class="controls">
      <p>CROSS-CUTTING ENGINEERING CONTROLS</p>
      <div><span>CONTRACTS &amp; POLICY VERSIONS</span><span>PROVENANCE &amp; LINEAGE</span><span>PERSISTENCE &amp; REPLAY</span><span>VALIDATION &amp; FAIL-CLOSED</span></div>
    </section>
  </div>

  <footer class="legend">
    <span><i class="d"></i>Deterministic responsibility</span>
    <span><i class="p"></i>Probabilistic AI</span>
    <span><i class="h"></i>Human authority</span>
    <span><i class="m"></i>Measurement only</span>
  </footer>
</section>

<style>
.s4-map{width:min(76rem,calc(100vw - 4rem));max-width:none;margin:2.5rem 0 3.5rem}.map-head{display:grid;grid-template-columns:1fr minmax(18rem,.72fr);gap:2rem;align-items:end;margin-bottom:1.4rem}.kicker{margin:0 0 .55rem!important;color:var(--aleph-green)!important;font-family:var(--font-mono);font-size:.78rem!important;letter-spacing:.16em}.map-head h2{margin:0!important;font-size:clamp(1.65rem,2.5vw,2.5rem)!important}.summary{margin:0!important;color:var(--aleph-text-muted)!important;font-size:.84rem!important;line-height:1.65!important}.frame{padding:clamp(1rem,2vw,1.5rem);border:1px solid rgba(90,180,220,.22);border-radius:1rem;background:radial-gradient(circle at 12% 8%,rgba(85,214,158,.045),transparent 22rem),radial-gradient(circle at 88% 50%,rgba(75,104,255,.055),transparent 28rem),rgba(3,18,34,.72)}.dual-source{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.source-column{padding:1rem;border:1px solid rgba(90,180,220,.14);border-radius:.75rem;background:rgba(8,27,48,.48)}.column-label,.controls p{margin:0 0 .65rem!important;color:var(--aleph-text-muted)!important;font-family:var(--font-mono);font-size:.60rem!important;letter-spacing:.13em}.down{padding:.4rem 0;color:var(--aleph-cyan);font-family:var(--font-mono);text-align:center}.node{min-width:0;padding:.8rem;border:1px solid rgba(90,180,220,.19);border-radius:.55rem;background:rgba(4,21,38,.78)}.node strong{display:block;margin-top:.28rem;color:var(--aleph-text-primary);font-size:1rem;line-height:1.3}.node small{display:block;margin-top:.42rem;color:var(--aleph-text-muted);font-size:.74rem;line-height:1.55}.node em{color:var(--aleph-green);font-family:var(--font-mono);font-size:.60rem;font-style:normal;letter-spacing:.11em}.node.ai{border-color:rgba(75,104,255,.38);background:linear-gradient(145deg,rgba(18,44,69,.72),rgba(21,26,68,.5))}.node.ai em{color:var(--aleph-cyan)}.merge{display:grid;grid-template-columns:1fr auto 1fr;gap:.8rem;align-items:center;padding:.55rem 16%}.merge span{height:1px;background:linear-gradient(90deg,transparent,var(--aleph-cyan))}.merge span:last-child{background:linear-gradient(90deg,var(--aleph-cyan),transparent)}.merge b{color:var(--aleph-green);font-family:var(--font-mono)}.layer{padding:1rem;border:1px solid rgba(90,180,220,.14);border-radius:.75rem;background:rgba(8,27,48,.54)}.layer>header{display:flex;gap:.75rem;align-items:center;margin-bottom:.85rem}.layer>header>b{color:var(--aleph-green);font-family:var(--font-mono);font-size:.78rem}.layer>header div{display:grid;gap:.14rem}.layer>header strong{font-size:1rem}.layer>header small{color:var(--aleph-text-muted);font-family:var(--font-mono);font-size:.60rem;letter-spacing:.10em}.wide-node,.evidence-row{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem}.wide-node span,.evidence-row span,.controls span{display:grid;place-items:center;min-height:2.25rem;padding:.45rem;border:1px solid rgba(90,180,220,.16);border-radius:.45rem;background:rgba(5,24,42,.68);color:var(--aleph-cyan);font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;text-align:center}.evidence-row{grid-template-columns:repeat(5,1fr)}.research{max-width:34rem;margin:auto}.split{display:grid;grid-template-columns:1fr auto 1fr;gap:.65rem;align-items:center}.join-arrow,.branch{color:var(--aleph-blue-bright);font-family:var(--font-mono);text-align:center}.scored{max-width:56rem;margin:auto}.branch{padding:.4rem}.branch-targets{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.opportunity{border-color:rgba(85,214,158,.32)}.shadow{border-style:dashed!important;border-color:rgba(90,180,220,.3)!important}.shadow em{color:var(--aleph-text-muted)!important}.operator-gate{display:grid;gap:.3rem;place-items:center;padding:.9rem;border:1px solid rgba(85,214,158,.42);border-radius:.65rem;background:rgba(19,61,55,.2);text-align:center}.operator-gate span{color:var(--aleph-green);font-family:var(--font-mono);font-size:.62rem;letter-spacing:.12em}.operator-gate strong{font-size:.94rem}.operator-gate small{color:var(--aleph-text-muted);font-size:.72rem}.pipeline,.decision-row,.human-flow{display:grid;gap:.55rem;align-items:stretch}.pipeline.five{grid-template-columns:1fr auto 1fr auto 1fr auto 1fr auto 1fr}.pipeline>i,.decision-row>i,.human-flow>i{align-self:center;color:var(--aleph-blue-bright);font-family:var(--font-mono);font-style:normal}.decision-row{grid-template-columns:1fr auto 1fr;max-width:48rem;margin:auto}.authority{display:grid;gap:.38rem;margin:1rem auto;max-width:34rem;text-align:center}.authority>span{color:var(--aleph-cyan);font-family:var(--font-mono);font-size:.62rem;letter-spacing:.10em}.authority>span:last-child{color:var(--aleph-green)}.authority>div{display:grid;grid-template-columns:1fr auto 1fr;gap:.35rem;align-items:center}.authority u{height:1px;background:linear-gradient(90deg,transparent,var(--aleph-cyan));text-decoration:none}.authority u:last-child{background:linear-gradient(90deg,var(--aleph-green),transparent)}.authority b{color:var(--aleph-text-muted);font-family:var(--font-mono);font-size:.58rem;font-weight:500;letter-spacing:.08em}.human-flow{grid-template-columns:1fr auto 1fr auto 1fr}.human{border-color:rgba(85,214,158,.42);background:rgba(19,61,55,.24)}.authoritative{border-color:rgba(85,214,158,.3)}.state-invariant{display:flex;flex-wrap:wrap;gap:.55rem;justify-content:center;align-items:center;margin-top:1rem;padding:.7rem;border:1px solid rgba(90,180,220,.14);border-radius:.55rem}.state-invariant span{color:var(--aleph-cyan);font-family:var(--font-mono);font-size:.66rem;letter-spacing:.09em}.state-invariant b{color:var(--aleph-green)}.state-invariant small{width:100%;color:var(--aleph-text-muted);font-size:.66rem;text-align:center}.controls{margin-top:1rem;padding-top:.9rem;border-top:1px solid rgba(90,180,220,.12)}.controls div{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem}.legend{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;margin-top:.85rem;color:var(--aleph-text-muted);font-family:var(--font-mono);font-size:.62rem}.legend span{display:flex;gap:.4rem;align-items:center}.legend i{width:.4rem;height:.4rem;border-radius:50%}.legend .d{background:var(--aleph-green)}.legend .p{background:var(--aleph-blue-bright)}.legend .h{border:1px solid var(--aleph-green)}.legend .m{border:1px dashed var(--aleph-cyan)}
@media(max-width:1180px){.s4-map{width:100%}.pipeline.five,.human-flow{grid-template-columns:1fr}.pipeline>i,.human-flow>i{justify-self:center;transform:rotate(90deg)}}@media(max-width:760px){.map-head,.dual-source,.split,.branch-targets,.decision-row{grid-template-columns:1fr}.join-arrow,.decision-row>i{justify-self:center;transform:rotate(45deg)}.wide-node,.evidence-row,.controls div{grid-template-columns:1fr}.frame{padding:.8rem}}
</style>
