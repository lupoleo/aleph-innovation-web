---
import { getLang } from "../../i18n";

const lang = getLang(Astro);

const {
  project = "agentic-portfolio",
  section,
  status = "published",
  updated,
} = Astro.props;

const projectNames = {
  en: { "agentic-portfolio": "AGENTIC PORTFOLIO", "environmental-monitoring": "ENVIRONMENTAL MONITORING" },
  it: { "agentic-portfolio": "AGENTIC PORTFOLIO", "environmental-monitoring": "MONITORAGGIO AMBIENTALE" },
  mt: { "agentic-portfolio": "AGENTIC PORTFOLIO", "environmental-monitoring": "MONITORAĠĠ AMBJENTALI" },
}[lang];

const projectLabel =
  projectNames[project] ?? project.replaceAll("-", " ").toUpperCase();

// Section codes from the front matter, shown in the page language.
const sectionNamesByLang: Record<string, Record<string, string>> = {
  it: {
  "project-home": "progetto",
  "overview": "panoramica",
  "system-overview": "panoramica del sistema",
  "architecture": "architettura",
  "contracts": "contratti",
  "implementation": "implementazione",
  "testing": "test",
  "development-history": "storia dello sviluppo",
  "risk-overview": "rischi",
  "risks": "rischi",
  },
  mt: {
    "project-home": "proġett",
    "overview": "ħarsa ġenerali",
    "system-overview": "ħarsa ġenerali lejn is-sistema",
    "architecture": "arkitettura",
    "contracts": "kuntratti",
    "implementation": "implimentazzjoni",
    "testing": "ittestjar",
    "development-history": "storja tal-iżvilupp",
    "risk-overview": "riskji",
    "risks": "riskji",
  },
};
const sectionNames = sectionNamesByLang[lang] ?? {};

const sectionLabel = section ? sectionNames[section] ?? section : section;

const statusNames = {
  en: { draft: "DRAFT", published: "PUBLISHED", archived: "ARCHIVED" },
  it: { draft: "BOZZA", published: "PUBBLICATO", archived: "ARCHIVIATO" },
  mt: { draft: "ABBOZZ", published: "IPPUBBLIKAT", archived: "ARKIVJAT" },
}[lang];

const statusLabel = statusNames[status] ?? status.toUpperCase();

const updatedLabel =
  updated instanceof Date
    ? updated.toLocaleDateString({ en: "en-GB", it: "it-IT", mt: "mt-MT" }[lang], {
        day: "2-digit",
        month: "short",
        year: "numeric",
      })
    : String(updated ?? "");

const updatedPrefix = { en: "UPDATED", it: "AGGIORNATO IL", mt: "AĠĠORNAT" }[lang];
---

<div class="article-meta">
  <span>{projectLabel}</span>

  {section && (
    <>
      <i aria-hidden="true">·</i>
      <span>{String(sectionLabel).toUpperCase()}</span>
    </>
  )}

  <i aria-hidden="true">·</i>

  <span class="article-status">{statusLabel}</span>

  {updatedLabel && (
    <>
      <i aria-hidden="true">·</i>
      <span>{updatedPrefix} {updatedLabel.toUpperCase()}</span>
    </>
  )}
</div>

<style>
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 0.5rem;

    margin-bottom: 1.35rem;

    color: var(--aleph-text-muted);

    font-family: var(--font-mono);
    font-size: 0.56rem;

    letter-spacing: 0.12em;
  }

  i {
    color: rgba(90, 180, 220, 0.35);

    font-style: normal;
  }

  .article-status {
    color: var(--aleph-green);
  }
</style>
